## Documentation Standards

@javadoc_requirements {
  "method_documentation": {
    "summary": "Provide concise summary for each function, class, or module",
    "parameters": "Document each parameter including data type, role, and default values",
    "return_value": "Specify return type and describe what is returned, including null cases",
    "exceptions": "List exceptions that may be thrown and under what circumstances",
    "examples": "For complex functions, provide usage examples and edge cases"
  },
  "class_documentation": {
    "scope": "Focus on purpose and functionality",
    "exclusions": ["class_dependencies", "@see_tags"],
    "requirements": ["concise_summary", "usage_context"]
  }
}

## Javadoc Format Template

@javadoc_template {
  "format": "/**\n * [Description of the method's purpose and functionality.]\n *\n * @param [parameterName] [description of parameter and its role]\n * @param [parameterName] [description of parameter and its role]\n * @return [description of what is returned, and when null or optional value is expected]\n * @throws [ExceptionType] [condition under which this exception is thrown]\n * @throws [ExceptionType] [condition under which this exception is thrown]\n * @author [Your Name]\n */",
  "output_format": "Markdown for easy copy-pasting"
}

## Documentation Rules

@documentation_rules [
  {
    "rule": "method_purpose",
    "description": "Every public method must have a clear purpose description",
    "enforcement": "mandatory"
  },
  {
    "rule": "parameter_documentation",
    "description": "All parameters must be documented with type and purpose",
    "format": "@param paramName description including data type and role",
    "enforcement": "mandatory"
  },
  {
    "rule": "return_documentation", 
    "description": "Return values must be documented including null/optional cases",
    "format": "@return description of return value and null conditions",
    "enforcement": "mandatory"
  },
  {
    "rule": "exception_documentation",
    "description": "All thrown exceptions must be documented with conditions",
    "format": "@throws ExceptionType condition when thrown",
    "enforcement": "mandatory"
  },
  {
    "rule": "complex_method_examples",
    "description": "Complex methods require usage examples and edge case discussion",
    "enforcement": "recommended"
  }
]

