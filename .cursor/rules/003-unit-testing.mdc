    "pattern": "[methodTested_ConditionTested_ExpectedResult]",
    "description": "Follow consistent naming pattern describing tested function and expected behavior"
  },
  {
    "principle": "isolation",
    "description": "Use mock objects or fakes to isolate the unit under test",
    "tools": ["Mockito", "@Mock", "@InjectMocks"]
  },
  {
    "principle": "aaa_pattern",
    "description": "Apply Arrange-Act-Assert pattern for clear and organized tests",
