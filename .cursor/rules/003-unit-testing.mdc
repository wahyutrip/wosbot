## Test Implementation Patterns

@implementation_patterns {
  "basic_test_structure": "// Arrange\n[Setup test data and mocks]\n\n// Act\n[Execute method under test]\n\n// Assert\n[Verify results and interactions]",
  "exception_testing": "// Arrange\n[Setup mocks to throw exception]\n\n// Act & Assert\nassertThatThrownBy(() -> methodUnderTest())\n    .isInstanceOf(ExpectedException.class)\n    .hasMessage(\"Expected message\");",
  "interaction_verification": "// Arrange & Act\n[Execute test]\n\n// Assert\nverify(mockDependency).methodCall(expectedParameters);\nverify(mockDependency, times(1)).methodCall(any());"
}

