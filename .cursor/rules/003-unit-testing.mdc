## Test Structure Template

@test_structure {
  "class_annotation": "@ExtendWith(MockitoExtension.class)",
  "field_annotations": ["@Mock", "@InjectMocks"],
  "method_structure": {
    "arrange": "Set up test data, mock behaviors, prepare dependencies",
    "act": "Execute the method under test",
    "assert": "Verify results, interactions, and side effects"
  }
}

## WoS Bot Testing Patterns

@project_testing {
  "task_testing": {
    "annotation": "@ExtendWith(MockitoExtension.class)",
    "focus": "Test task execution logic, rescheduling, configuration usage",
    "mock_dependencies": "Mock EmulatorManager, helpers, profile, OCR providers",
    "scenarios": ["successful_execution", "stamina_insufficient", "emulator_not_running", "ocr_failure", "rescheduling"]
  },
  "service_testing": {
    "annotation": "@ExtendWith(MockitoExtension.class)",
    "focus": "Test service methods (ServScheduler, ServProfiles, ServLogs, EmulatorManager)",
    "mock_dependencies": "Mock repositories, emulators, task queues",
    "singleton_pattern": "Test singleton access patterns, thread safety"
  },
  "helper_testing": {
    "annotation": "@ExtendWith(MockitoExtension.class)",
    "focus": "Test helper methods (NavigationHelper, StaminaHelper, etc.)",
    "mock_dependencies": "Mock EmulatorManager, OCR providers, profile",
    "scenarios": ["successful_operation", "failure_handling", "retry_logic"]
  },
  "repository_testing": {
    "annotation": "@ExtendWith(MockitoExtension.class) or in-memory SQLite",
    "focus": "Test repository methods, HQL queries, entity relationships",
    "database": "Use in-memory SQLite for integration tests",
    "query_testing": "Test custom HQL queries and entity methods"
  },
  "emulator_testing": {
    "annotation": "@ExtendWith(MockitoExtension.class)",
    "focus": "Test emulator operations (screenshot, tap, swipe, package detection)",
    "mock_dependencies": "Mock ddmlib IDevice, AndroidDebugBridge",
    "scenarios": ["successful_operation", "adb_failure", "device_not_found", "timeout"]
  },
  "javafx_testing": {
    "annotation": "@ExtendWith(MockitoExtension.class)",
    "focus": "Test JavaFX controllers, FXML binding, event handlers",
    "mock_dependencies": "Mock services, use TestFX for UI testing if needed",
    "note": "JavaFX requires JavaFX application thread, use Platform.runLater() for testing"
  }
}

