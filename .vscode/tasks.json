{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "maven: compile",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "compile",
                "-DskipTests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$tsc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "maven: package",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "install",
                "package",
                "-DskipTests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$tsc"
            ],
            "group": "build"
        }
    ]
}
